# Copy to .env (make init does this). See spec §15.
TZ=Asia/Ho_Chi_Minh
# Address published ports bind to on the host. Use 0.0.0.0 only for a Kali/UTM demo client (plan §3).
PUBLISH_ADDR=127.0.0.1
TLS_MODE=selective
WORK_HOURS_MODE=real
ICAP_BYPASS=off
ICAP_ENABLED=1
GUEST_RATE_BYTES=262144
UT1_CATEGORIES=gambling games social_networks phishing malware
ABUSECH_AUTH_KEY=
